# 1. Виртуальное окружение (папка со всеми скачанными библиотеками)
venv/
.venv/
env/

# 2. Кэш Python и фреймворка Pytest (технические файлы для быстрого перезапуска тестов)
__pycache__/
*.pyc
.pytest_cache/

# 3. Локальные папки отчетов Allure
allure-results/
allure-report/

# 4. Специфические настройки сред разработки (если вы работаете в PyCharm или VS Code)
.idea/
.vscode/